rules_version = '2';

// Grayum household budget — invite-only.
// Only two verified email addresses may read or write ANY document.
// Everyone else (signed out, unverified, or any other account) is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'mrgrayum@gmail.com',
             'stephanie.grayum@gmail.com'
           ];
    }

    // Single shared household budget: one data tree, both users full access.
    match /{document=**} {
      allow read, write: if isAllowedUser();
    }
  }
}
