rules_version = '2';

// Receipt photos for the Grayum household budget — same invite-only
// allowlist as firestore.rules. Deploy alongside the Firestore rules:
//   firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'mrgrayum@gmail.com',
             'stephanie.grayum@gmail.com'
           ];
    }

    // Receipt images live under receipts/{transactionId}/{fileName}
    match /receipts/{transactionId}/{fileName} {
      allow read, write: if isAllowedUser();
    }

    // Nothing else in the bucket is accessible.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
